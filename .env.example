# ---------------------------------------------------------------------------
# Contact form delivery (Zoho Mail)
# ---------------------------------------------------------------------------
# Copy this file to .env.local for development, and set the same values in the
# host's environment for production. Without them /api/enquiry returns 503 and
# the form shows its error state - deliberately loud, so an enquiry is never
# silently lost.
#
# HOST: percapita.in's MX records point at mx.zoho.com, so the mailbox is on
# Zoho's .com data centre. Use the .in equivalents only if Zoho's admin console
# says the account lives in the India DC.
#
#   smtp.zoho.com      <- VERIFIED WORKING for this account, 23 Sep 2026
#   smtppro.zoho.com      refused with "554 5.7.8 Access Restricted"
#
# smtppro is the paid-plan host; this account's plan does not permit it. If the
# plan is ever upgraded, smtppro may start working, but there is no need to
# switch. Confirm in Zoho Mail: Settings > Mail Accounts > IMAP/SMTP.
#
# PASSWORD: if two-factor authentication is on (it should be), a normal
# password will NOT work here. Generate an application-specific password:
# accounts.zoho.com > Security > App Passwords.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=lead@percapita.in
SMTP_PASS=

# Where enquiries land. Defaults to CONTACT.email when unset.
ENQUIRY_TO=lead@percapita.in

# Canonical origin, used by metadata, robots.txt, the sitemap and the
# structured data. Defaults to https://percapita.in.
NEXT_PUBLIC_SITE_URL=https://percapita.in
